# ==========================================
# VEHICLE EXPENSE — Root .gitignore
# ==========================================

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
**/node_modules/

# ------------------------------------------
# Environment Variables / Secrets
# (NEVER commit real secrets to git)
# ------------------------------------------
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Keep example/template env files and production env (needed for Vercel build)
!.env.example
!*/.env.example
!frontend/.env.production

# ------------------------------------------
# Frontend — Vite / React Build Output
# ------------------------------------------
frontend/dist/
frontend/build/
frontend/.vite/

# ------------------------------------------
# Backend — Build Output
# ------------------------------------------
backend/dist/
backend/build/

# ------------------------------------------
# Backend — Logs
# ------------------------------------------
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Prisma — SQLite local databases (if any)
# ------------------------------------------
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-shm
backend/prisma/*.db-wal

# ------------------------------------------
# Test / Coverage
# ------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov

# ------------------------------------------
# Cache / Temporary Files
# ------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
tmp/
temp/
*.tmp
*.pid
*.seed

# ------------------------------------------
# OS Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
ehthumbs.db

# ------------------------------------------
# Windows
# ------------------------------------------
*.stackdump

# ------------------------------------------
# IDE / Editors
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------
# Deployment Platforms
# ------------------------------------------
.vercel/
.render/
.netlify/

# ------------------------------------------
# Misc
# ------------------------------------------
*.tgz
*.zip